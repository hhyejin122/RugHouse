<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.Pilotproject.dao.IproductDAO">
	<select id="productList" resultType="com.springboot.Pilotproject.dto.productDTO">
		select * from product order by pno desc
	</select>
	<select id="productView" resultType="com.springboot.Pilotproject.dto.productDTO">
		select * from product where pno=#{pno}
	</select>
	<insert id="productWrite">
		insert into product(pno,pcategory,pmade,pname,pprice,pdesc,pstock,pdate,pfile,mno)
		 values(product_seq.NEXTVAL,#{pcategory},#{pmade},#{pname},#{pprice},#{pdesc},#{pstock},SYSDATE,#{pfile},#{mno})
	</insert>
	<update id="productUpdate">
		update product set pcategory=#{pcategory},pmade=#{pmade},pname=#{pname},pprice=#{pprice},pdesc=#{pdesc},pstock=#{pstock},pfile=#{pfile}
		 where pno=#{pno}
	</update>
	<delete id="productDelete">
		delete from product where pno=#{pno}
	</delete>
</mapper>