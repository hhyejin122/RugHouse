<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper 
	PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
	"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.Pilotproject.dao.ImemberDAO">
	<select id="memberList" resultType="com.springboot.Pilotproject.dto.memberDTO">
		select * from member order by mno desc
	</select>
	<select id="memberView" resultType="com.springboot.Pilotproject.dto.memberDTO">
		select * from member where mid=#{mid}
	</select>
	<select id="findById" resultType="com.springboot.Pilotproject.dto.memberDTO">
		select * from member where mid=#{mid}
	</select>
	<insert id="memberWrite">
		insert into member(mno,mid,mpasswd,mname,mgender,maddr,mzipno,mtel,memail,mdate,mauthority)
 		 values(member_seq.NEXTVAL,#{mid},#{mpasswd},#{mname},#{mgender},#{maddr},#{mzipno},#{mtel},#{memail},SYSDATE,'USER')
	</insert>
	<update id="memberUpdate">
		update member set mpasswd=#{mpasswd},maddr=#{maddr},mzipno=#{mzipno},mtel=#{mtel},memail=#{memail} where mid=#{mid}
	</update>
	<delete id="memberDelete">
		delete from member where mid=#{mid}
	</delete>
</mapper>